---
import Layout from "../layouts/Layout.astro";

// =====================================================================
//  TRACKS  ->  ADD YOUR AUDIO FILES HERE
// ---------------------------------------------------------------------
//  1. Drop the audio files into:  public/audio/
//  2. Reference them below in `src` as "/audio/<filename>".
//     (Anything in public/ is served from the site root, so a file at
//      public/audio/little-peek.mp3 is reachable at "/audio/little-peek.mp3")
// =====================================================================
const tracks = [
  { title: "Little Peek", duration: "02:52", src: "/audio/little-peek.mp3" },
  { title: "At the Gates of Rimal Kubra", duration: "03:05", src: "/audio/at-the-gates-of-rimal-kubra.mp3" },
  { title: "The Ascension of Rimal Kubra", duration: "01:26", src: "/audio/the-ascension-of-rimal-kubra.mp3" },
  { title: "Icarus' Curse", duration: "02:56", src: "/audio/icarus-curse.mp3" },
  { title: "Giants from the East and Elders", duration: "03:21", src: "/audio/giants-from-the-east-and-elders.mp3" },
];

const SITE_URL = "https://glen-glen.vercel.app/";
const ARTIST = "glenglen";
const ALBUM = "journeys";
const GENRE = "Psychedelic Rock";
const COVER = "/journeys-cover.jpg";
const LOGO = "/glenglenlogo.png";
const EMAIL = "glenglen.band@gmail.com";

// "mm:ss" <-> seconds helpers.
const toSeconds = (mmss: string) => {
  const [m, s] = mmss.split(":").map(Number);
  return m * 60 + s;
};
const totalSeconds = tracks.reduce((sum, t) => sum + toSeconds(t.duration), 0);
const totalLabel = `${Math.floor(totalSeconds / 60)}:${String(totalSeconds % 60).padStart(2, "0")}`;

// Convert "mm:ss" to ISO 8601 duration (e.g. "02:52" -> "PT2M52S").
const toIso = (mmss: string) => {
  const [m, s] = mmss.split(":").map(Number);
  return `PT${m}M${s}S`;
};
const toIsoSeconds = (sec: number) => `PT${Math.floor(sec / 60)}M${sec % 60}S`;

const title = `${ARTIST} — ${ALBUM}`;
const description = `${ALBUM} — the new album from ${ARTIST}. ${GENRE}. Stream all ${tracks.length} tracks: ${tracks
  .slice(0, 3)
  .map((t) => t.title)
  .join(", ")} and more.`;

const abs = (path: string) => new URL(path, SITE_URL).href;
const pad = (n: number) => String(n).padStart(2, "0");

// schema.org: the band and the album, with its recordings.
const artistRef = { "@type": "MusicGroup", "@id": `${SITE_URL}#artist`, name: ARTIST };
const recordings = tracks.map((t) => ({
  "@type": "MusicRecording",
  name: t.title,
  duration: toIso(t.duration),
  byArtist: artistRef,
  inAlbum: { "@id": `${SITE_URL}#album` },
  associatedMedia: {
    "@type": "AudioObject",
    contentUrl: abs(t.src),
    encodingFormat: "audio/mpeg",
  },
}));

const musicGroupSchema = {
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  "@id": `${SITE_URL}#artist`,
  name: ARTIST,
  alternateName: "GlenGlen",
  genre: GENRE,
  url: SITE_URL,
  image: abs(LOGO),
  logo: abs(LOGO),
  email: EMAIL,
  album: { "@id": `${SITE_URL}#album` },
};

const musicAlbumSchema = {
  "@context": "https://schema.org",
  "@type": "MusicAlbum",
  "@id": `${SITE_URL}#album`,
  name: ALBUM,
  byArtist: artistRef,
  genre: GENRE,
  url: SITE_URL,
  image: abs(COVER),
  albumReleaseType: "https://schema.org/AlbumRelease",
  numTracks: tracks.length,
  duration: toIsoSeconds(totalSeconds),
  track: recordings,
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: ARTIST,
  url: SITE_URL,
};
---

<Layout title={title} description={description} schema={[musicGroupSchema, musicAlbumSchema, websiteSchema]}>
  <!--
    The page is the album cover, unfolded: a stack of full-bleed horizontal
    bands. "glenglen" sits top-left and "journeys" bottom-right, exactly as on
    the sleeve; the tracklist and player live in the bands between. Thin cream
    pinstripes (.rule) breathe with the music — see scripts/visualizer.ts.
  -->
  <div class="page">
    <div class="band band--green band--top" aria-hidden="true"></div>
    <div class="rule" aria-hidden="true"><i></i></div>

    <div class="band band--cream">
      <div class="wrap">
        <h1 class="display">{ARTIST}</h1>
      </div>
    </div>

    <div class="band band--green band--flex" aria-hidden="true"></div>

    <main>
      <h2 class="sr-only">Tracklist</h2>
      <ol class="tracks" id="tracklist">
        {
          tracks.map((track, i) => (
            <li
              class="track-item"
              data-index={i}
              data-src={track.src}
              data-title={track.title}
            >
              <button class="track-btn" type="button" aria-label={`Play ${track.title}`}>
                <span class="track-ind" aria-hidden="true">
                  <span class="track-num">{pad(i + 1)}</span>
                  <svg class="ico-play" viewBox="0 0 24 24"><path d="M7 4.5v15L19.5 12z" /></svg>
                  <svg class="ico-pause" viewBox="0 0 24 24"><path d="M6 4.5h4.5v15H6zM13.5 4.5H18v15h-4.5z" /></svg>
                  <span class="track-eq">
                    <span class="eq-bar" />
                    <span class="eq-bar" />
                    <span class="eq-bar" />
                  </span>
                </span>
                <span class="track-title">{track.title}</span>
                <span class="track-dur">{track.duration}</span>
              </button>
            </li>
          ))
        }
      </ol>

      <div class="band band--cream">
        <div class="wrap">
          <p class="display display--album">{ALBUM}</p>
        </div>
      </div>

      <div class="band band--green band--info">
        <div class="rule" data-viz-band="0" aria-hidden="true"><i></i></div>
        <div class="wrap footer-row">
          <p class="label">the new {GENRE.toLowerCase()} album · {tracks.length} tracks · {totalLabel}</p>
          <!-- Click anywhere on the email (or the icon) to copy it. -->
          <button class="label copy-email" id="copy-email" type="button" data-email={EMAIL} title="Copy email" aria-label={`Copy email address ${EMAIL}`}>
            <span class="copy-email-text">{EMAIL}</span>
            <svg class="ico-copy" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="8.5" y="8.5" width="11" height="11" />
              <path d="M15.5 8.5v-4h-11v11h4" />
            </svg>
            <svg class="ico-check" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4.5 12.5l5 5 10-11" />
            </svg>
          </button>
          <span class="sr-only" id="copy-status" aria-live="polite"></span>
        </div>
      </div>

      <section class="player" aria-label="Player">
        <div class="wrap">
          <!-- Progress -->
          <div class="progress">
            <span class="time time--current" id="current-time">00:00</span>
            <div
              class="progress-bar"
              id="progress-track"
              role="slider"
              tabindex="0"
              aria-label="Seek"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
            >
              <div class="progress-rail">
                <!-- Hover preview (where you'd seek to) -->
                <div class="progress-hover" id="progress-hover"></div>
                <!-- Played portion -->
                <div class="progress-fill" id="progress-fill">
                  <span class="progress-thumb" id="progress-thumb"></span>
                </div>
              </div>
            </div>
            <span class="time" id="total-time">00:00</span>
          </div>

          <!-- Controls: now playing | transport | volume -->
          <div class="controls">
            <div class="now">
              <img
                class="now-art"
                src="/journeys-cover-thumb.jpg"
                alt={`${ALBUM} album cover`}
                width="160"
                height="160"
              />
              <div class="now-text">
                <p class="now-title" id="now-playing-title">{tracks[0].title}</p>
                <p class="now-sub">{ARTIST} — {ALBUM}</p>
              </div>
            </div>

            <div class="transport">
              <button class="icon-btn" id="prev-btn" type="button" aria-label="Previous track">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h2.5v14H5zM9 12l10 7V5z" /></svg>
              </button>
              <button class="icon-btn play-btn" id="play-btn" type="button" aria-label="Play">
                <svg class="ico-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15L19.5 12z" /></svg>
                <svg class="ico-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4.5h4.5v15H6zM13.5 4.5H18v15h-4.5z" /></svg>
              </button>
              <button class="icon-btn" id="next-btn" type="button" aria-label="Next track">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.5 5H19v14h-2.5zM5 19l10-7L5 5z" /></svg>
              </button>
            </div>

            <!-- Volume (pointer devices only; touch users use OS volume). -->
            <div class="volume">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 9v6h4l5 5V4L7 9zm13.5 3A4.5 4.5 0 0 0 14 8v8a4.5 4.5 0 0 0 2.5-4zM14 3.2v2.1a7 7 0 0 1 0 13.4v2.1a9 9 0 0 0 0-17.6z" />
              </svg>
              <div class="volume-track" id="volume-track" aria-label="Volume">
                <div class="volume-rail">
                  <div class="volume-fill" id="volume-fill"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

</Layout>

<style is:global>
  .page {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  .wrap {
    width: 100%;
    max-width: var(--wrap);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* --- Bands --- */
  .band--green {
    background: var(--green);
  }
  .band--cream {
    background: var(--cream);
  }
  /* Decorative green bands soak up spare height so tall screens get the
     cover's generous proportions and short screens simply scroll. */
  .band--top {
    /* Plain green, like the top of the sleeve. */
    flex: 3 0 48px;
  }
  .band--flex {
    flex: 1 0 14px;
  }
  /* main holds tracks → journeys → info → player; it flexes so the info
     band inside it can grow like the page-level spacers. */
  main {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
  }
  /* Album line + email, right above the player. Grows on tall screens so
     the player always sits at the very bottom of the page. */
  .band--info {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    padding-bottom: 20px;
  }
  .footer-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 16px;
    margin-top: 12px;
  }
  .copy-email {
    appearance: none;
    border: 0;
    background: none;
    padding: 2px 0;
    margin-left: auto;
    color: var(--ink);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-align: left;
  }
  .copy-email-text {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }
  .copy-email svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
  }
  .copy-email .ico-check,
  .copy-email.is-copied .ico-copy {
    display: none;
  }
  .copy-email.is-copied .ico-check {
    display: block;
  }
  .copy-email:hover .copy-email-text {
    text-decoration-thickness: 3px;
  }

  .label {
    font: 600 13px/1.2 var(--font-text);
    letter-spacing: 0.06em;
    margin: 0;
  }

  /* --- Pinstripes: a cream line inside a green strip. The line swells with
         its frequency band (--b, 0..1, written by the visualizer). scaleY
         keeps it off the layout path; the strip is tall enough to contain
         the maximum swell. --- */
  .rule {
    height: 20px;
    display: flex;
    align-items: center;
    background: var(--green);
  }
  .rule i {
    display: block;
    width: 100%;
    height: 5px;
    background: var(--cream);
  }
  /* Only the stripe under "journeys" carries a band and pulses; every other
     stripe stays still so no other row appears to change size. */
  .rule[data-viz-band] i {
    transform: scaleY(calc(1 + var(--b, 0) * 1.4));
    will-change: transform;
  }

  /* --- Wordmarks: the cover's lettering --- */
  .page {
    /* Wordmark size: fills the band on phones, capped by viewport height on
       desktop so the whole sleeve fits one screen. */
    --display-size: clamp(3.5rem, min(15vw, 11vh), 10rem);
  }
  .display {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--display-size);
    line-height: 1;
    letter-spacing: -0.005em;
    color: var(--ink);
    padding-block: 0.12em 0.2em;
  }
  .display--album {
    text-align: right;
  }

  /* --- Tracklist: each track is a green stripe; cream hairlines between.
         The current track turns cream and merges with its neighbours into a
         thicker cream band — the cover's rhythm, driven by playback. --- */
  .tracks {
    list-style: none;
    margin: 0;
    /* Cream hairline above track 01 and below track 05 too, so the first and
       last rows merge into one cream band exactly like the middle ones —
       no green sliver between a playing edge track and its neighbour. */
    padding: 5px 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: var(--cream);
  }
  .track-item {
    background: var(--green);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .track-item.is-current {
    background: var(--cream);
  }
  .track-btn {
    appearance: none;
    border: 0;
    background: none;
    font: inherit;
    color: var(--ink);
    text-align: left;
    cursor: pointer;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 12px;
    width: 100%;
    max-width: var(--wrap);
    margin-inline: auto;
    padding: 12px var(--gutter);
  }
  .track-btn:focus-visible {
    outline-offset: -3px;
  }
  .track-ind {
    position: relative;
    display: flex;
    align-items: center;
    height: 1.75rem;
  }
  .track-num {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1;
  }
  .track-ind svg {
    display: none;
    width: 1.5rem;
    height: 1.5rem;
    fill: currentColor;
  }
  .track-title {
    font-weight: 600;
    font-size: clamp(1rem, 0.92rem + 0.45vw, 1.3rem);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .track-item.is-current .track-title {
    font-weight: 700;
  }
  .track-dur {
    font-weight: 500;
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
  }

  /* Indicator states: number → play on hover; equalizer while playing →
     pause on hover. Hover rules only for real pointers (no sticky touch). */
  .track-eq {
    display: none;
    gap: 3px;
    align-items: flex-end;
    height: 1rem;
  }
  .track-eq .eq-bar {
    width: 4px;
    height: 100%;
    background: currentColor;
    transform-origin: bottom;
    animation: eq-bounce 0.9s ease-in-out infinite;
  }
  .track-eq .eq-bar:nth-child(1) {
    animation-delay: -0.6s;
  }
  .track-eq .eq-bar:nth-child(2) {
    animation-delay: -0.3s;
  }
  .track-eq .eq-bar:nth-child(3) {
    animation-delay: -0.45s;
  }
  @keyframes eq-bounce {
    0%,
    100% {
      transform: scaleY(0.3);
    }
    50% {
      transform: scaleY(1);
    }
  }
  .track-item.is-playing .track-num {
    display: none;
  }
  .track-item.is-playing .track-eq {
    display: flex;
  }
  @media (hover: hover) {
    .track-item:not(.is-current):hover {
      background: var(--green-hi);
    }
    .track-item:hover .track-num {
      display: none;
    }
    .track-item:not(.is-playing):hover .ico-play {
      display: block;
    }
    .track-item.is-playing:hover .track-eq {
      display: none;
    }
    .track-item.is-playing:hover .ico-pause {
      display: block;
    }
  }

  /* --- Player: the one band in the cover's ink colour --- */
  .player {
    background: var(--ink);
    color: var(--cream);
    z-index: 10;
    padding-block: 16px 20px;
  }
  /* Once music has started, the player sticks to the bottom of the viewport
     on any screen size (it stays pinned after pause so play is always one
     tap away). It's the last band, so at the page end it simply sits in
     place. */
  body.has-started .player {
    position: sticky;
    bottom: 0;
  }
  .progress {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .time {
    flex: 0 0 2.75rem;
    font: 500 12px/1 var(--font-text);
    font-variant-numeric: tabular-nums;
    color: var(--cream-muted);
  }
  .time--current {
    text-align: right;
  }
  .progress-bar {
    flex: 1;
    position: relative;
    height: 20px;
    display: flex;
    align-items: center;
    cursor: pointer;
    user-select: none;
    touch-action: none;
  }
  .progress-rail {
    position: relative;
    width: 100%;
    height: 4px;
    background: var(--cream-faint);
    transition: height 0.15s ease-out;
  }
  .progress-bar:hover .progress-rail,
  .progress-bar.is-scrubbing .progress-rail {
    height: 8px;
  }
  .progress-hover,
  .progress-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0;
  }
  .progress-hover {
    background: var(--cream-faint);
    opacity: 0;
    transition: opacity 0.15s;
    pointer-events: none;
  }
  .progress-bar:hover .progress-hover {
    opacity: 1;
  }
  .progress-fill {
    background: var(--green);
  }
  /* Flat vertical bar for a thumb — a tiny stripe, not a knob. */
  .progress-thumb {
    position: absolute;
    right: 0;
    top: 50%;
    width: 5px;
    height: 18px;
    background: var(--cream);
    transform: translate(50%, -50%) scaleY(0);
    transition: transform 0.15s ease-out;
  }
  .progress-bar:hover .progress-thumb,
  .progress-bar.is-scrubbing .progress-thumb,
  .progress-bar:focus-visible .progress-thumb {
    transform: translate(50%, -50%) scaleY(1);
  }
  .progress-bar:focus-visible {
    outline: 3px solid var(--green);
    outline-offset: 2px;
  }

  .controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    margin-top: 14px;
  }
  .now {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }
  .now-art {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    display: block;
  }
  .now-text {
    min-width: 0;
  }
  .now-title {
    margin: 0;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .now-sub {
    margin: 3px 0 0;
    font-size: 12px;
    font-weight: 500;
    color: var(--cream-muted);
  }

  .transport {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .icon-btn {
    appearance: none;
    border: 0;
    background: none;
    padding: 0;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: var(--cream);
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s, transform 0.1s;
  }
  .icon-btn:hover {
    color: var(--green);
  }
  .icon-btn:active {
    transform: scale(0.94);
  }
  .icon-btn:focus-visible {
    outline-color: var(--green);
  }
  .icon-btn svg {
    width: 28px;
    height: 28px;
    fill: currentColor;
  }
  /* Square, like everything on the sleeve. */
  .play-btn {
    width: 60px;
    height: 60px;
    background: var(--green);
    color: var(--ink);
  }
  .play-btn:hover {
    background: var(--cream);
    color: var(--ink);
  }
  .play-btn svg {
    width: 30px;
    height: 30px;
  }
  .play-btn .ico-pause,
  body.is-playing .play-btn .ico-play {
    display: none;
  }
  body.is-playing .play-btn .ico-pause {
    display: block;
  }

  .volume {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    color: var(--cream-muted);
  }
  .volume svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  .volume-track {
    width: 112px;
    height: 20px;
    display: flex;
    align-items: center;
    cursor: pointer;
  }
  .volume-rail {
    width: 100%;
    height: 4px;
    background: var(--cream-faint);
  }
  .volume-fill {
    width: 66.6%;
    height: 100%;
    background: var(--cream-muted);
    transition: background-color 0.15s;
  }
  .volume-track:hover .volume-fill {
    background: var(--green);
  }

  /* --- Small screens: stack now-playing above a centred transport --- */
  @media (max-width: 639px) {
    .label {
      font-size: 12px;
    }
    .track-btn {
      grid-template-columns: 2.25rem minmax(0, 1fr) auto;
      column-gap: 10px;
      padding-block: 14px;
    }
    .controls {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .transport {
      justify-content: center;
      gap: 32px;
    }
    .volume {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track-eq .eq-bar {
      animation: none;
      transform: scaleY(0.7);
    }
    .rule[data-viz-band] i {
      transform: none;
    }
  }
</style>

<script>
  import { initVisualizer } from "../scripts/visualizer";

  // Audio-reactive pinstripes, fed by the two audio decks so the stripes
  // breathe with whatever is playing.
  const viz = initVisualizer();

  const items = Array.from(document.querySelectorAll<HTMLLIElement>(".track-item"));
  const playBtn = document.getElementById("play-btn");
  const prevBtn = document.getElementById("prev-btn");
  const nextBtn = document.getElementById("next-btn");
  const progressTrack = document.getElementById("progress-track");
  const progressFill = document.getElementById("progress-fill");
  const currentTimeEl = document.getElementById("current-time");
  const totalTimeEl = document.getElementById("total-time");
  const nowPlayingTitle = document.getElementById("now-playing-title");
  const volumeTrack = document.getElementById("volume-track");
  const volumeFill = document.getElementById("volume-fill");

  // ===== Crossfade configuration =====
  // Length of the overlap between a track ending and the next starting.
  // No silent gap occurs: the next track begins while the current is still
  // fading out. Tweak this value (in seconds) to taste.
  const CROSSFADE_SECONDS = 0.6;

  // Two "decks" let us overlap two tracks for a true gapless crossfade.
  // A single <audio> element can't overlap with itself.
  const decks = [new Audio(), new Audio()];
  decks.forEach((d) => {
    d.preload = "auto";
    // Route each deck through the shared analyser so the visualizer can read
    // its frequency data. (Same-origin audio, so no CORS concerns.)
    viz.connect(d);
  });
  let activeDeck = 0; // index into `decks` that is the foreground track
  let masterVolume = decks[0].volume; // user-set volume (0..1), independent of fade
  let crossfading = false;
  let scrubbing = false; // true while the user is dragging the progress bar

  const audio = () => decks[activeDeck];
  const other = () => decks[activeDeck === 0 ? 1 : 0];

  let current = 0;
  // No row is highlighted until playback first starts — on arrival every
  // track is a plain green stripe, even though track 1 is preloaded.
  let started = false;

  const fmt = (s: number) => {
    if (!isFinite(s)) return "00:00";
    const m = Math.floor(s / 60);
    const sec = Math.floor(s % 60);
    return `${String(m).padStart(2, "0")}:${String(sec).padStart(2, "0")}`;
  };

  // The current track's stripe turns cream (styled via .is-current).
  function highlight(index: number) {
    if (!started) return;
    items.forEach((item, i) => item.classList.toggle("is-current", i === index));
  }

  function setPlayingState(playing: boolean) {
    items.forEach((item, i) => {
      item.classList.toggle("is-playing", playing && i === current);
    });
    // Drives the play/pause icon swap on the main button.
    document.body.classList.toggle("is-playing", playing);
    playBtn?.setAttribute("aria-label", playing ? "Pause" : "Play");
    viz.setActive(playing);
  }

  function updateNowPlaying(index: number) {
    const item = items[index];
    if (!item) return;
    if (nowPlayingTitle) nowPlayingTitle.textContent = item.dataset.title ?? "";
    highlight(index);
  }

  // Load a track onto the active deck and (optionally) play it.
  // Used for explicit selection / prev / next, NOT for the auto crossfade.
  function load(index: number, autoplay = false) {
    const item = items[index];
    if (!item) return;
    cancelCrossfade();
    current = index;
    const deck = audio();
    deck.volume = masterVolume;
    deck.src = item.dataset.src ?? "";
    updateNowPlaying(index);
    setPlayingState(false);
    if (autoplay) deck.play().catch(() => {});
  }

  function togglePlay() {
    // AudioContext must be resumed from within a user gesture (autoplay policy).
    viz.resume();
    const deck = audio();
    if (!deck.src) {
      load(current, true);
      return;
    }
    if (deck.paused) deck.play().catch(() => {});
    else deck.pause();
  }

  // ===== Crossfade engine =====
  //
  // Background-tab correctness: when a tab is open but NOT focused/visible,
  // browsers throttle requestAnimationFrame to a near-stop and slow `timeupdate`
  // events down to ~once per second or worse. Relying on those alone makes track
  // switching lag (the next track starts late) or hang mid-fade. To stay gapless
  // regardless of visibility we:
  //   1. SCHEDULE the crossfade with a setTimeout armed from track metadata, so
  //      it fires on time even when timeupdate is throttled.
  //   2. RAMP volume off a timer-driven clock (setInterval) instead of rAF, so
  //      the fade completes even when rAF is frozen. Timers keep firing in
  //      background tabs (clamped, but they fire); rAF does not.
  //   3. Keep `ended` as a final safety net.
  let crossfadeTimer = 0; // setInterval handle driving the volume ramp
  let crossfadeStart = 0; // performance.now() when the current fade began
  let scheduledFadeTimeout = 0; // setTimeout handle that triggers startCrossfade

  function clearScheduledFade() {
    if (scheduledFadeTimeout) clearTimeout(scheduledFadeTimeout);
    scheduledFadeTimeout = 0;
  }

  // Arm a timer to begin the crossfade exactly CROSSFADE_SECONDS before the end
  // of the active deck. Re-armed on metadata load, seek, and play. This is the
  // primary trigger; `timeupdate` is only a backup for when the timer drifts.
  function scheduleFade() {
    clearScheduledFade();
    const deck = audio();
    if (!deck.duration || !isFinite(deck.duration) || deck.paused) return;
    const remaining = deck.duration - deck.currentTime - CROSSFADE_SECONDS;
    if (remaining <= 0) {
      if (!crossfading) startCrossfade();
      return;
    }
    scheduledFadeTimeout = window.setTimeout(() => {
      if (!crossfading && !audio().paused) startCrossfade();
    }, remaining * 1000);
  }

  function cancelCrossfade() {
    if (crossfadeTimer) clearInterval(crossfadeTimer);
    crossfadeTimer = 0;
    clearScheduledFade();
    crossfading = false;
    // Make sure the background deck is stopped and silenced.
    const bg = other();
    bg.pause();
    bg.currentTime = 0;
    bg.volume = masterVolume;
  }

  // Begin overlapping the next track on the other deck and ramp volumes.
  function startCrossfade() {
    if (crossfading) return;
    clearScheduledFade();
    const nextIndex = (current + 1) % items.length;
    const item = items[nextIndex];
    if (!item) return;

    crossfading = true;
    const fromDeck = audio();
    const toDeck = other();

    toDeck.src = item.dataset.src ?? "";
    toDeck.currentTime = 0;
    toDeck.volume = 0;

    // Once the incoming track can play, the foreground switches to it so the
    // UI (progress, title, indicator) tracks the track you actually hear.
    current = nextIndex;
    activeDeck = activeDeck === 0 ? 1 : 0; // toDeck becomes active
    updateNowPlaying(current);
    setPlayingState(true);

    toDeck.play().catch(() => {});

    crossfadeStart = performance.now();
    const durationMs = CROSSFADE_SECONDS * 1000;

    const apply = () => {
      const t = Math.min(1, (performance.now() - crossfadeStart) / durationMs);
      // Equal-power crossfade keeps perceived loudness constant (no dip).
      const inGain = Math.sin((t * Math.PI) / 2);
      const outGain = Math.cos((t * Math.PI) / 2);
      toDeck.volume = masterVolume * inGain;
      fromDeck.volume = masterVolume * outGain;
      if (t >= 1) {
        if (crossfadeTimer) clearInterval(crossfadeTimer);
        crossfadeTimer = 0;
        fromDeck.pause();
        fromDeck.currentTime = 0;
        fromDeck.volume = masterVolume;
        toDeck.volume = masterVolume;
        crossfading = false;
        // Arm the next track's fade as soon as this one settles.
        scheduleFade();
      }
    };

    // A ~30ms interval is silky when visible and still advances (clamped to
    // ~1s) when hidden — either way the fade reaches completion. rAF would
    // freeze entirely in a background tab, so we deliberately avoid it here.
    if (crossfadeTimer) clearInterval(crossfadeTimer);
    crossfadeTimer = window.setInterval(apply, 30);
    apply();
  }

  playBtn?.addEventListener("click", togglePlay);
  prevBtn?.addEventListener("click", () => load((current - 1 + items.length) % items.length, !audio().paused));
  nextBtn?.addEventListener("click", () => load((current + 1) % items.length, !audio().paused));

  items.forEach((item, i) => {
    item.addEventListener("click", () => {
      viz.resume(); // user gesture — safe to start the AudioContext
      // Clicking the track that's already loaded toggles play/pause
      // instead of restarting it; clicking a different track loads + plays it.
      if (i === current && audio().src && !crossfading) {
        togglePlay();
      } else {
        load(i, true);
      }
    });
  });

  // Wire shared playback events for BOTH decks; handlers act only when the
  // event comes from whichever deck is currently active.
  decks.forEach((deck) => {
    deck.addEventListener("play", () => {
      if (deck !== audio()) return;
      if (!started) {
        started = true;
        highlight(current);
        // Pin the player to the bottom of the viewport from here on.
        document.body.classList.add("has-started");
      }
      setPlayingState(true);
      // (Re)arm the timer-based fade trigger now that we're actually playing.
      if (!crossfading) scheduleFade();
    });
    deck.addEventListener("pause", () => {
      if (deck !== audio() || crossfading) return;
      setPlayingState(false);
      // No point holding a fade timer for a paused track; it re-arms on play.
      clearScheduledFade();
    });
    deck.addEventListener("loadedmetadata", () => {
      if (deck !== audio()) return;
      if (totalTimeEl) totalTimeEl.textContent = fmt(deck.duration);
      scheduleFade();
    });
    deck.addEventListener("timeupdate", () => {
      if (deck !== audio()) return;
      if (currentTimeEl) currentTimeEl.textContent = fmt(deck.currentTime);
      // Don't fight the user while they're dragging the scrubber.
      if (progressFill && deck.duration && !scrubbing) {
        progressFill.style.width = `${(deck.currentTime / deck.duration) * 100}%`;
        progressTrack?.setAttribute("aria-valuenow", String(Math.round((deck.currentTime / deck.duration) * 100)));
      }
      // Kick off the crossfade once we're within the crossfade window of the end.
      if (
        deck.duration &&
        !crossfading &&
        deck.duration - deck.currentTime <= CROSSFADE_SECONDS
      ) {
        startCrossfade();
      }
    });
    // Safety net: if a track ends without a crossfade having started
    // (e.g. track shorter than the crossfade window), advance immediately.
    deck.addEventListener("ended", () => {
      if (deck !== audio() || crossfading) return;
      load((current + 1) % items.length, true);
    });
  });

  // ===== Progress bar: scrub (drag), hover preview, keyboard =====
  const progressHover = document.getElementById("progress-hover");

  const ratioFromEvent = (clientX: number) => {
    if (!progressTrack) return 0;
    const rect = progressTrack.getBoundingClientRect();
    return Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
  };

  const renderProgress = (ratio: number) => {
    if (progressFill) progressFill.style.width = `${ratio * 100}%`;
    progressTrack?.setAttribute("aria-valuenow", String(Math.round(ratio * 100)));
  };

  const seekToRatio = (ratio: number) => {
    const deck = audio();
    if (!deck.duration) return;
    deck.currentTime = ratio * deck.duration;
    renderProgress(ratio);
    if (currentTimeEl) currentTimeEl.textContent = fmt(deck.currentTime);
    // Remaining time changed → re-arm the scheduled fade.
    if (!crossfading) scheduleFade();
  };

  // Hover preview: show where a click would land.
  progressTrack?.addEventListener("pointermove", (e) => {
    if (!progressHover) return;
    const ratio = ratioFromEvent(e.clientX);
    progressHover.style.width = `${ratio * 100}%`;
  });

  // Drag to scrub.
  progressTrack?.addEventListener("pointerdown", (e) => {
    if (!audio().duration) return;
    scrubbing = true;
    progressTrack.classList.add("is-scrubbing");
    progressTrack.setPointerCapture(e.pointerId);
    seekToRatio(ratioFromEvent(e.clientX));
  });
  progressTrack?.addEventListener("pointermove", (e) => {
    if (!scrubbing) return;
    seekToRatio(ratioFromEvent(e.clientX));
  });
  const endScrub = (e: PointerEvent) => {
    if (!scrubbing) return;
    scrubbing = false;
    progressTrack?.classList.remove("is-scrubbing");
    try {
      progressTrack?.releasePointerCapture(e.pointerId);
    } catch {}
  };
  progressTrack?.addEventListener("pointerup", endScrub);
  progressTrack?.addEventListener("pointercancel", endScrub);

  // Keyboard seeking (arrow keys = ±5s, Home/End = start/end).
  progressTrack?.addEventListener("keydown", (e) => {
    const deck = audio();
    if (!deck.duration) return;
    let handled = true;
    switch (e.key) {
      case "ArrowRight":
        deck.currentTime = Math.min(deck.duration, deck.currentTime + 5);
        break;
      case "ArrowLeft":
        deck.currentTime = Math.max(0, deck.currentTime - 5);
        break;
      case "Home":
        deck.currentTime = 0;
        break;
      case "End":
        deck.currentTime = deck.duration;
        break;
      default:
        handled = false;
    }
    if (handled) {
      e.preventDefault();
      renderProgress(deck.currentTime / deck.duration);
      if (!crossfading) scheduleFade();
    }
  });

  volumeTrack?.addEventListener("click", (e) => {
    const rect = volumeTrack.getBoundingClientRect();
    const ratio = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
    masterVolume = ratio;
    // Apply immediately unless a crossfade is mid-ramp (it owns volume then).
    if (!crossfading) audio().volume = masterVolume;
    if (volumeFill) volumeFill.style.width = `${ratio * 100}%`;
  });

  // When the tab regains focus, timers may have been clamped/drifted while
  // hidden. Re-sync the progress UI and re-arm the fade schedule against the
  // real currentTime so nothing is left stale by background throttling.
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) return;
    const deck = audio();
    if (deck.duration && !scrubbing) {
      renderProgress(deck.currentTime / deck.duration);
      if (currentTimeEl) currentTimeEl.textContent = fmt(deck.currentTime);
    }
    if (!crossfading && !deck.paused) scheduleFade();
  });

  // Preload the first track's metadata
  load(0);
</script>

<script>
  // Footer email: clicking copies the address instead of opening a mail app.
  const copyBtn = document.getElementById("copy-email");
  const copyStatus = document.getElementById("copy-status");
  let copiedTimer = 0;

  const copyText = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // Fallback for non-secure contexts / older browsers.
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand("copy");
      ta.remove();
      return ok;
    }
  };

  copyBtn?.addEventListener("click", async () => {
    const email = copyBtn.dataset.email ?? "";
    if (!(await copyText(email))) return;
    copyBtn.classList.add("is-copied");
    copyBtn.title = "Copied!";
    if (copyStatus) copyStatus.textContent = "Email copied to clipboard";
    clearTimeout(copiedTimer);
    copiedTimer = window.setTimeout(() => {
      copyBtn.classList.remove("is-copied");
      copyBtn.title = "Copy email";
      if (copyStatus) copyStatus.textContent = "";
    }, 1800);
  });
</script>
