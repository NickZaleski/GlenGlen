---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  /** Optional JSON-LD structured data object(s) to embed in <head>. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

// Update this to your production domain so that canonical/social URLs
// resolve to absolute links.
const SITE_URL = "https://glen-glen.vercel.app/";

const {
  title = "glenglen — journeys",
  description = "journeys — the new album from glenglen. Psychedelic rock.",
  image = "/og-image.png",
  imageAlt = "glenglen — journeys: green and cream striped album artwork",
  schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const imageUrl = new URL(image, SITE_URL).href;
const schemaList = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <!-- Favicons: the glenglen logo (public/glenglenlogo.png). -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#88af38" />
    <title>{title}</title>

    <!-- Primary meta -->
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph (Facebook, LinkedIn, Discord, etc.) -->
    <meta property="og:type" content="music.album" />
    <meta property="og:site_name" content="glenglen" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Structured data (schema.org JSON-LD) -->
    {
      schemaList.map((entry) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(entry)} />
      ))
    }

    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <!-- Alfa Slab One matches the lettering on the "journeys" cover;
         Roboto Slab carries the UI text in the same slab voice. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Roboto+Slab:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* ==================================================================
         JOURNEYS DESIGN SYSTEM
         Taken straight from the album cover: flat horizontal bands of
         lime-olive green and cream, heavy lowercase slab type in deep ink.
         No gradients, no glow, no rounded corners — just stripes.
         ================================================================== */
      :root {
        --green: #88af38;
        --green-hi: #95bb46; /* hover tint of the green band */
        --cream: #feffef;
        --ink: #2e3b10;
        --cream-muted: rgba(254, 255, 239, 0.7); /* secondary text on ink */
        --cream-faint: rgba(254, 255, 239, 0.18); /* rails on ink */

        --font-display: "Alfa Slab One", "Rockwell", Georgia, serif;
        --font-text: "Roboto Slab", "Rockwell", Georgia, serif;

        --gutter: clamp(16px, 4vw, 56px);
        --wrap: 1200px;
        color-scheme: light;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
      }
      body {
        /* Green so overscroll/bounce matches the top and bottom bands. */
        background: var(--green);
        color: var(--ink);
        font-family: var(--font-text);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
      }
      ::selection {
        background: var(--ink);
        color: var(--cream);
      }
      :focus-visible {
        outline: 3px solid var(--ink);
        outline-offset: 2px;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
